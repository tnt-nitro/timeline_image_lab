{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "feedback",
  "type": "object",
  "required": ["run_id", "render_id", "version", "items"],
  "properties": {
    "run_id": { "type": "string" },
    "render_id": { "type": "string" },
    "version": { "type": "integer", "minimum": 1 },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["annotation_id", "area", "type", "severity", "note"],
        "properties": {
          "annotation_id": { "type": "string" },
          "annotation_ref": {
            "type": "object",
            "properties": {
              "tool": { "type": "string" },
              "color": { "type": "string" },
              "meaning": { "type": "string" },
              "bbox": {
                "type": "array",
                "items": { "type": "number" },
                "minItems": 4,
                "maxItems": 4
              },
              "polygon": {
                "type": "array",
                "items": {
                  "type": "array",
                  "items": { "type": "number" },
                  "minItems": 2,
                  "maxItems": 2
                },
                "minItems": 3
              }
            }
          },
          "area": { "type": "string" },
          "type": {
            "enum": ["geometry", "color", "label", "presence", "depth"]
          },
          "severity": {
            "enum": ["minor", "major", "critical"]
          },
          "note": { "type": "string" },
          "expected": { "type": "string" }
        }
      }
    }
  }
}

